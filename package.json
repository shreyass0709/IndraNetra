{
  "name": "indranetra-workspace",
  "version": "1.0.0",
  "description": "IndraNetra AI Crowd Intelligence Workspace",
  "scripts": {
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "generate:prisma": "cd backend && npx prisma generate --schema=../prisma/schema.prisma",
    "db:push": "cd backend && npx prisma db push --schema=../prisma/schema.prisma",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:ai": "cd ai-service && python -m uvicorn api.main:app --host 0.0.0.0 --port 8000 --reload"
  },
  "devDependencies": {
    "prisma": "^5.18.0"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "cloudinary": "^2.10.0",
    "resend": "^6.12.4"
  }
}
