{
  "name": "indranetra-workspace",
  "version": "1.0.0",
  "description": "IndraNetra AI Crowd Intelligence Workspace",
  "scripts": {
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "generate:prisma": "npm run prisma --prefix backend generate --schema=../prisma/schema.prisma",
    "db:push": "npm run prisma --prefix backend db push --schema=../prisma/schema.prisma",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:ai": "python -m uvicorn ai-service.api.main:app --host 0.0.0.0 --port 8000 --reload"
  },
  "devDependencies": {
    "prisma": "^5.18.0"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0"
  }
}
