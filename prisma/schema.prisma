datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

enum Role {
  ADMIN
  ORGANIZER
  VOLUNTEER
  PUBLIC
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SOSStatus {
  PENDING
  DISPATCHED
  RESOLVED
}

enum VolunteerStatus {
  AVAILABLE
  ASSIGNED
  INACTIVE
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  passwordHash      String
  role              Role               @default(PUBLIC)
  avatar            String?
  profileComplete   Boolean            @default(false)
  emailVerified     Boolean            @default(false)
  isApproved        Boolean            @default(true)
  verificationToken String?
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  reports           Report[]
  sosRequests       SOSRequest[]
  volunteer         Volunteer?
  organizerProfile  OrganizerProfile?
  publicUserProfile PublicUserProfile?
  notifications     Notification[]

  @@map("users")
}

model OrganizerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String
  designation      String
  contactNumber    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PublicUserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber      String
  emergencyContact String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Event {
  id             String        @id @default(uuid())
  name           String
  eventType      String        @default("CONCERT") @map("event_type")
  description    String?
  location       String
  latitude       Float
  longitude      Float
  expectedCrowd  Int           @default(0) @map("expected_crowd")
  maxCapacity    Int           @map("max_capacity")
  areaSqMeters   Float?        @map("area_sq_meters") // Real venue area; enables true people/m² density instead of a capacity-derived estimate
  thresholdLimit Int           @map("threshold_limit")
  status         String        @default("Upcoming") // Upcoming, Live, Completed, Cancelled
  startTime      DateTime      @map("start_time")
  endTime        DateTime      @map("end_time")
  entryGates     Int           @default(1) @map("entry_gates")
  exitGates      Int           @default(1) @map("exit_gates")
  cameraCount    Int           @default(0) @map("camera_count")
  volunteerCount Int           @default(0) @map("volunteer_count")
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  crowdReports   CrowdReport[]
  alerts         Alert[]
  cameras        Camera[]
  volunteers     Volunteer[]

  @@map("events")
}

model CrowdReport {
  id           String    @id @default(uuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id])
  peopleCount  Int
  densityLevel Float     // people per square meter
  riskLevel    RiskLevel @default(LOW)
  heatmapUrl   String?   // path/url to heatmap overlay image
  snapshotUrl  String?   // path/url to snapshot
  timestamp    DateTime  @default(now())
}

model Alert {
  id         String    @id @default(uuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  type       String    // OVERCROWDING, EMERGENCY, DANGER, SOS
  message    String
  riskLevel  RiskLevel @default(MEDIUM)
  isResolved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model Volunteer {
  id           String          @id @default(uuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       VolunteerStatus @default(AVAILABLE)
  latitude     Float?
  longitude    Float?
  lastActive   DateTime?       @default(now())
  assignedArea String?         // Description of area
  // The event/location this volunteer is approved for. Null until an
  // organizer/admin assigns them; assignment is what grants dashboard access
  // (together with User.isApproved). See AUTH_AND_ROLES.md.
  eventId      String?
  event        Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sosRequests  SOSRequest[]
  reports      Report[]

  // Volunteer Profile Fields
  phoneNumber  String?
  skills       String?
  availability String?
}

model SOSRequest {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  latitude            Float
  longitude           Float
  issueType           String    // MEDICAL, STAMPEDE_RISK, FIRE, SECURITY, OTHER
  description         String?
  status              SOSStatus @default(PENDING)
  assignedVolunteerId String?
  assignedVolunteer   Volunteer? @relation(fields: [assignedVolunteerId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Report {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  title               String
  description         String
  latitude            Float
  longitude           Float
  evidenceUrl         String?  // Cloudinary file url
  fileType            String?  // IMAGE, VIDEO
  assignedVolunteerId String?
  assignedVolunteer   Volunteer? @relation(fields: [assignedVolunteerId], references: [id])
  status              String   @default("PENDING") // PENDING, DISPATCHED, RESOLVED
  createdAt           DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Camera {
  id           String            @id @default(uuid())
  name         String
  location     String
  cameraSource String            @default("Laptop Webcam") // Laptop Webcam, Mobile Camera, RTSP Camera, Video File
  status       String            @default("Offline")       // Online, Offline
  aiEnabled    Boolean           @default(true)
  createdBy    String?           // User name or role
  rtspUrl      String            // URL/Path for RTSP, Video File, or Mobile Camera
  eventId      String
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  analytics    CameraAnalytics[]

  @@map("cameras")
}

model CameraAnalytics {
  id          String   @id @default(uuid())
  cameraId    String
  camera      Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  peopleCount Int
  density     Float
  riskLevel   String
  timestamp   DateTime @default(now())

  @@map("camera_analytics")
}

