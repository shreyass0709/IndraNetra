datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

enum Role {
  ADMIN
  ORGANIZER
  VOLUNTEER
  PUBLIC
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SOSStatus {
  PENDING
  DISPATCHED
  RESOLVED
}

enum VolunteerStatus {
  AVAILABLE
  ASSIGNED
  INACTIVE
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  passwordHash      String
  role              Role               @default(PUBLIC)
  avatar            String?
  profileComplete   Boolean            @default(false)
  emailVerified     Boolean            @default(false)
  isApproved        Boolean            @default(true)
  verificationToken String?
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  reports           Report[]
  sosRequests       SOSRequest[]
  volunteer         Volunteer?
  organizerProfile  OrganizerProfile?
  publicUserProfile PublicUserProfile?
  notifications     Notification[]

  @@map("users")
}

model OrganizerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String
  designation      String
  contactNumber    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PublicUserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber      String
  emergencyContact String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Event {
  id             String        @id @default(uuid())
  name           String
  eventType      String        @default("CONCERT") @map("event_type")
  description    String?
  location       String
  latitude       Float
  longitude      Float
  expectedCrowd  Int           @default(0) @map("expected_crowd")
  maxCapacity    Int           @map("max_capacity")
  areaSqMeters   Float?        @map("area_sq_meters") // Real venue area; enables true people/m² density instead of a capacity-derived estimate
  thresholdLimit Int           @map("threshold_limit")
  status         String        @default("Upcoming") // Upcoming, Live, Completed, Cancelled
  startTime      DateTime      @map("start_time")
  endTime        DateTime      @map("end_time")
  entryGates     Int           @default(1) @map("entry_gates")
  exitGates      Int           @default(1) @map("exit_gates")
  cameraCount    Int           @default(0) @map("camera_count")
  volunteerCount Int           @default(0) @map("volunteer_count")
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  crowdReports   CrowdReport[]
  alerts         Alert[]
  cameras        Camera[]
  volunteers     Volunteer[]
  zones          Zone[]
  gates          Gate[]

  @@map("events")
}

// A bounded area within an event: "Main Stage Pit", "Gate A Approach", "Food Court".
//
// Density is only defined over a bounded area, so the zone -- not the event -- is the
// unit that density, risk, alerting and evacuation origin are computed on. An event
// averaging 1.2 ppl/m² can hold 7 in one zone; the event-wide number cannot see that.
model Zone {
  id               String   @id @default(uuid())
  eventId          String   @map("event_id")
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name             String
  // Perimeter as [[lat, lng], ...]. Drawn on the map by an organizer/admin.
  polygon          Json
  // Measured ground area. The denominator for this zone's density, so it is
  // required -- there is no defensible way to guess it.
  areaSqMeters     Float    @map("area_sq_meters")
  capacity         Int?
  // Fruin LoS: 4 ppl/m² is where movement becomes significantly restricted.
  thresholdDensity Float    @default(4.0) @map("threshold_density")
  cameras          Camera[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([eventId])
  @@map("zones")
}

// A physical gate with a real position and width.
//
// Event.entryGates/exitGates are integers -- a count, not a place. You cannot route
// to a number, which is why the current evacuation code hardcodes "Gate #3". Routing
// needs coordinates, and honest egress timing needs width: a gate passes roughly
// 1.3 people per metre of width per second (Fruin's specific flow), so a 3 m gate
// holds ~4 people/s no matter how short the walk to it is.
model Gate {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  latitude    Float
  longitude   Float
  widthMeters Float    @default(3.0) @map("width_meters")
  type        GateType @default(EXIT)
  isOpen      Boolean  @default(true) @map("is_open")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([eventId])
  @@map("gates")
}

enum GateType {
  ENTRY
  EXIT
  BOTH
}

model CrowdReport {
  id           String    @id @default(uuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id])
  peopleCount  Int
  densityLevel Float     // people per square meter
  riskLevel    RiskLevel @default(LOW)
  heatmapUrl   String?   // path/url to heatmap overlay image
  snapshotUrl  String?   // path/url to snapshot
  timestamp    DateTime  @default(now())
}

model Alert {
  id         String    @id @default(uuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  type       String    // OVERCROWDING, EMERGENCY, DANGER, SOS
  message    String
  riskLevel  RiskLevel @default(MEDIUM)
  isResolved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model Volunteer {
  id           String          @id @default(uuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       VolunteerStatus @default(AVAILABLE)
  latitude     Float?
  longitude    Float?
  lastActive   DateTime?       @default(now())
  assignedArea String?         // Description of area
  // The event/location this volunteer is approved for. Null until an
  // organizer/admin assigns them; assignment is what grants dashboard access
  // (together with User.isApproved). See AUTH_AND_ROLES.md.
  eventId      String?
  event        Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sosRequests  SOSRequest[]
  reports      Report[]

  // Volunteer Profile Fields
  phoneNumber  String?
  skills       String?
  availability String?
}

model SOSRequest {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  latitude            Float
  longitude           Float
  issueType           String    // MEDICAL, STAMPEDE_RISK, FIRE, SECURITY, OTHER
  description         String?
  status              SOSStatus @default(PENDING)
  assignedVolunteerId String?
  assignedVolunteer   Volunteer? @relation(fields: [assignedVolunteerId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Report {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  title               String
  description         String
  latitude            Float
  longitude           Float
  evidenceUrl         String?  // Cloudinary file url
  fileType            String?  // IMAGE, VIDEO
  assignedVolunteerId String?
  assignedVolunteer   Volunteer? @relation(fields: [assignedVolunteerId], references: [id])
  status              String   @default("PENDING") // PENDING, DISPATCHED, RESOLVED
  createdAt           DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Camera {
  id           String            @id @default(uuid())
  name         String
  location     String
  // Where this camera actually sits, chosen per-camera when it is placed.
  // Nullable: cameras created before placement existed have no coordinates,
  // and the map must not invent one for them.
  latitude     Float?
  longitude    Float?
  // 4-point ground calibration: image pixels -> real ground metres.
  // {
  //   imagePoints:  [[x,y] x4],  // marked on the frame, in perimeter order
  //   worldPoints:  [[X,Y] x4],  // the same 4 corners in metres, same order
  //   imageWidth, imageHeight,   // resolution the points were marked at
  //   densityRadiusM?            // local-density radius, default 1.5
  // }
  // Null = uncalibrated: density degrades to count/assumed-area, which is a
  // frame-wide average and cannot see a hotspot. See ai-service/prediction/ground.py.
  calibration  Json?
  zoneId       String?           @map("zone_id")
  zone         Zone?             @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  cameraSource String            @default("Laptop Webcam") // Laptop Webcam, Mobile Camera, RTSP Camera, Video File
  status       String            @default("Offline")       // Online, Offline
  aiEnabled    Boolean           @default(true)
  createdBy    String?           // User name or role
  rtspUrl      String            // URL/Path for RTSP, Video File, or Mobile Camera
  eventId      String
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  analytics    CameraAnalytics[]

  @@map("cameras")
}

model CameraAnalytics {
  id          String   @id @default(uuid())
  cameraId    String
  camera      Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  peopleCount Int
  density     Float
  riskLevel   String
  timestamp   DateTime @default(now())

  @@map("camera_analytics")
}

